@startuml
skinparam defaultFontName Arial
title OP-01 Check Availability + OP-02 Create Reservation (v0.2)
start
:Uživatel zadá časový interval, typ vozu a SPZ;
if (Interval zarovnán na 30 min a v budoucnu? (BR-01)) then (ano)
  if (Typ vozu == PHEV?) then (ano)
    :Vyloučit vysokorychlostní stanice HPC (BR-04);
  else (ne)
    :Zahrnout všechny stanice (AC, DC, HPC);
  endif
  #FFF3C4:OP-01: Vyhledat stanice bez překryvu
  s CONFIRMED nebo PENDING_APPROVAL (BR-02 v0.2);
  #FFF3C4:Zobrazit seznam volných stanic
  (DC/HPC označit „vyžaduje schválení“, BR-06);
  :Uživatel vybere konkrétní stanici;
  if (Kompatibilita vozu a vybrané stanice? (BR-04)) then (ano)
    :OP-02: Vytvořit rezervaci ve stavu DRAFT;
    :Nastavit expiraci na 5 minut (BR-05);
    :Vrátit reservationId uživateli;
    stop
  else (ne)
    :Chyba: PHEV nesmí rezervovat HPC;
    stop
  endif
else (ne)
  :Chyba: Neplatný nebo nezarovnaný interval;
  stop
endif
legend right
  <back:#FFF3C4>   </back> změna v0.2
endlegend
@enduml
